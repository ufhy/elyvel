import { Response } from '@elyvel/auth'

/**
 * {{class}} — authorization policy for the {{resource}} resource. Each method is
 * an ability: it receives the authenticated user (or `null`) plus any context,
 * and returns a boolean or a {@link Response} (for a message / custom status).
 *
 * Register it in a provider, then check it:
 *   gate.policy(Model, new {{class}}())
 *   gate.forUser(user).authorize('update', resource)
 */
export class {{class}} {
  update(user: { id: unknown } | null, resource: { authorId: unknown }): boolean | Response {
    return user?.id === resource.authorId ? Response.allow() : Response.deny()
  }
}

export default {{class}}
