 * {{class}} — a RESTful controller. Wire it up in a `routes/` file:
 *
 *   import { apiResource } from '@elyvel/core'
 *   import { {{class}} } from '../app/controllers/{{class}}'
 *   export default apiResource('/{{kebab}}', {{class}})
 *
 * Only the methods you define are routed. `apiResource` wires the 5 JSON
 * actions (index/store/show/update/destroy). Rendering a form instead (e.g.
