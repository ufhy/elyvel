import { defineModel, integer, sqliteTable, text } from '@elysia-ravel/orm'

/** The `{{table}}` table schema. Add columns here — types flow to the model. */
export const {{table}} = sqliteTable('{{table}}', {
  id: integer('id').primaryKey({ autoIncrement: true }),
  // name: text('name').notNull(),
  createdAt: text('created_at').notNull().default('CURRENT_TIMESTAMP'),
})

/** {{class}} model — typed CRUD + query helpers over the table above. */
export const {{class}} = defineModel({{table}})

export default {{class}}
