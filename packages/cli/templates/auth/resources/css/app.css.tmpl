@import 'tailwindcss';

/* Drive `dark:` variants off a `.dark` class on <html> (set by useAppearance),
   instead of Tailwind v4's default `prefers-color-scheme` media query. */
@custom-variant dark (&:where(.dark, .dark *));

:root {
  color-scheme: light;
}

.dark {
  color-scheme: dark;
}

html {
  font-family:
    ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}
