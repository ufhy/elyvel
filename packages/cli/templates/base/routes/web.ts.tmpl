import { route } from '@elyvel/core'

/**
 * Web routes. Files under routes/ are auto-mounted at boot. Return a value and
 * the framework serializes it to JSON; return `view(...)` / `Inertia.render(...)`
 * for HTML. See the docs to add controllers, middleware, and validation.
 *
 * Browser/session routes should run through the built-in `web` group, which
 * applies CSRF protection (needs sessions enabled). API/token routes don't —
 * they're CSRF-immune — so leave them out of it:
 *
 *   import { group, route } from '@elyvel/core'
 *   export default route()
 *     .use(group('web'))                 // CSRF for cookie-based routes
 *     .post('/profile', updateProfile)
 */
export default route().get('/api/health', () => ({ status: 'ok', app: '{{appName}}' }))
