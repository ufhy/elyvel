APP_NAME="{{appName}}"
APP_ENV=local
# Detailed error pages (stack traces). Never true on a public deploy.
APP_DEBUG=true

# App key — session/encryption secret. Set it with: bun run key:generate
APP_KEY=

PORT=3000

DB_CONNECTION=sqlite

# Social sign-in (opt-in) — fill in a provider's pair to show its button.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: dedicated Better Auth secret (defaults to APP_KEY when unset).
# BETTER_AUTH_SECRET=

# Logging. Read by config/logging.ts — the format never follows APP_ENV.
LOG_LEVEL=info

# Send the session cookie over HTTPS only. A browser will NOT send a Secure
# cookie over http, including on localhost — leave false for local dev.
SESSION_SECURE_COOKIE=false
