{
  "name": "@elyvel/vite",
  "type": "module",
  "version": "0.1.0-alpha.3",
  "description": "Vite integration for elyvel \u2014 asset tags + serve a Vite SPA (no Inertia required)",
  "author": "ufhy",
  "license": "MIT",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/ufhy/elyvel/issues"
  },
  "keywords": [
    "assets",
    "bun",
    "elyvel",
    "vite"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plugin": {
      "types": "./plugin.d.ts",
      "default": "./plugin.mjs"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "plugin.d.mts",
    "plugin.d.ts",
    "plugin.mjs",
    "src"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@elyvel/core": "workspace:*",
    "@elyvel/support": "workspace:*",
    "elysia": ">=1.4.0"
  }
}
