{
  "name": "@elyvel/database",
  "type": "module",
  "version": "0.0.0",
  "description": "A Laravel Eloquent-style Active Record ORM for Bun (SQLite + Postgres + MySQL)",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@elyvel/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@elyvel/support": "workspace:*",
    "@elyvel/validation": "workspace:*"
  },
  "devDependencies": {
    "kysely": "^0.29.3",
    "mysql2": "^3.23.0",
    "postgres": "^3.4.9"
  }
}
