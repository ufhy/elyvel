{
  "name": "@elyvel/database",
  "type": "module",
  "version": "0.1.0-alpha.1",
  "description": "A Laravel Eloquent-style Active Record ORM for Bun (SQLite + Postgres + MySQL)",
  "author": "ufhy",
  "license": "MIT",
  "homepage": "https://github.com/ufhy/elyvel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufhy/elyvel.git",
    "directory": "packages/database"
  },
  "bugs": {
    "url": "https://github.com/ufhy/elyvel/issues"
  },
  "keywords": [
    "bun",
    "eloquent",
    "elyvel",
    "migrations",
    "mysql",
    "orm",
    "postgres",
    "query-builder",
    "sqlite"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@elyvel/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@elyvel/cli": "workspace:*",
    "@elyvel/support": "workspace:*",
    "@elyvel/validation": "workspace:*"
  },
  "devDependencies": {
    "kysely": "^0.29.3",
    "mysql2": "^3.23.0",
    "postgres": "^3.4.9"
  }
}
