# Optional test configuration — copy to `.env` (gitignored) and edit.
#
# Point MYSQL_URL at a running MySQL server to include MySQL in the database
# test suite. With it set, a plain `bun test` (from the repo root) runs the full
# Active Record suite on sqlite + pglite (Postgres) + mysql. Unset → MySQL is
# skipped. Create the database first: CREATE DATABASE IF NOT EXISTS ravel_test;
MYSQL_URL=mysql://root:password@localhost:3306/ravel_test
