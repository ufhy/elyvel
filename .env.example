# Optional test configuration — copy to `.env` (gitignored) and edit.
#
# Point these at running servers to include a REAL Postgres / MySQL server in the
# database test suite (alongside the in-process sqlite + pglite). A dialect whose
# URL is unset (or unreachable) is skipped. Create the databases first:
#   Postgres:  createdb elyvel_test
#   MySQL:     mysql -uroot -p -e "CREATE DATABASE elyvel_test"
POSTGRES_URL=postgres://postgres:password@localhost:5432/elyvel_test
MYSQL_URL=mysql://root:password@localhost:3306/elyvel_test

# Which dialects `bun test` runs (comma-separated): sqlite, pglite, pg, mysql.
# Omit this line to run every configured dialect. Trim it for faster local runs.
TEST_DIALECTS=sqlite,pglite,pg,mysql
