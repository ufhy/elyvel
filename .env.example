# Optional test configuration — copy to `.env` (gitignored) and edit.
#
# Point these at running servers to include a REAL Postgres / MySQL server in the
# database test suite (alongside the in-process sqlite + pglite). A plain
# `bun test` (from the repo root) then runs the full Active Record suite on every
# configured dialect; unset → that dialect is skipped. Create the databases first:
#   Postgres:  createdb ravel_test
#   MySQL:     mysql -uroot -p -e "CREATE DATABASE ravel_test"
POSTGRES_URL=postgres://postgres:password@localhost:5432/ravel_test
MYSQL_URL=mysql://root:password@localhost:3306/ravel_test
