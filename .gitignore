node_modules
dist
*.tsbuildinfo
.env
.env.local

# npm auth tokens — a project-level .npmrc holds a publish token in plaintext
.npmrc
.DS_Store
bun.lockb
# runtime databases (anywhere, incl. examples/*/database)
*.sqlite
*.sqlite-shm
*.sqlite-wal
**/database/pglite/
# app runtime storage (uploads, cache, sessions) — scoped so it doesn't catch packages/storage
examples/*/storage/
# Vite build output (regenerated by `vite build`)
**/public/build/
# Written by the elyvel() vite plugin while a dev server is running.
**/public/hot
# Playwright MCP scratch
.playwright-mcp/
.claude/settings.json
# editor workspace settings (local)
.vscode/
# local scratch/experiments — folder itself is tracked (see playground/.gitignore), contents are not
# VitePress
docs/.vitepress/cache
docs/.vitepress/dist
