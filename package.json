{
  "name": "elyvel",
  "version": "0.0.0",
  "private": true,
  "description": "A Laravel-inspired, Elysia-first application framework for Bun",
  "workspaces": [
    "packages/*",
    "examples/*",
    "playground/*",
    "docs"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "bun scripts/test-all.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p examples/fullstack-vue/tsconfig.json && tsc -p examples/spa-vue/tsconfig.json",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "release": "bun scripts/release.ts",
    "test:all": "bun scripts/test-all.ts",
    "test:one": "bun test"
  },
  "dependencies": {
    "dayjs": "^1.11.21"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@types/bun": "^1.3.14",
    "eslint": "^10",
    "typescript": "^6.0.3"
  }
}
