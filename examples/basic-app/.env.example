APP_NAME="Basic App"
APP_ENV=local

# Secret for `encrypted` model casts (AES-256-GCM). Generate one with:
#   bun -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=

PORT=3000

# Read/write split (optional) — primary for writes, replica(s) for reads:
# DB_WRITE_URL=postgres://primary:5432/app
# DATABASE_URL=postgres://replica:5432/app
